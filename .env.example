# ─────────────────────────────────────────────────────────────────────────────
# CauSium — Environment Variables Reference
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Values: development | production
APP_ENV=development
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
# Generate a valid Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-32-byte-fernet-key-here=

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=causium
POSTGRES_PASSWORD=causium_dev
POSTGRES_DB=causium
# Dev: no SSL. Production: add ?sslmode=require (or verify-ca / verify-full).
DATABASE_URL=postgresql+asyncpg://causium:causium_dev@localhost:5432/causium
# TLS enforcement (SP-A07). Set true in production.
DB_SSL_ENABLED=false
DB_SSL_VERIFY=true
# Path to PEM CA cert used when DB_SSL_ENABLED=true
DB_SSL_CA_FILE=
DB_SSL_MIN_VERSION=TLSv1.3

# ── Redis ─────────────────────────────────────────────────────────────────────
# Dev: redis://. Production: rediss:// (TLS).
REDIS_URL=redis://localhost:6379/0
REDIS_SSL_VERIFY=true
REDIS_SSL_CA_FILE=
REDIS_SSL_MIN_VERSION=TLSv1.3

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=causium
CLICKHOUSE_PASSWORD=causium_dev
CLICKHOUSE_DB=causium
# Set true in production (port 8443).
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CA_CERT=
CLICKHOUSE_SSL_MIN_VERSION=TLSv1.3

# ── Azure Cloud Connector ─────────────────────────────────────────────────────
# Leave empty to use the mock connector (dev/testing).
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_CARBON_API_URL=
# OIDC SSO callback (update to your production domain)
AZURE_OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/azure/callback
AZURE_OIDC_SCOPES=openid profile email
OIDC_JWKS_CACHE_TTL_SECONDS=300

# ── AWS Cloud Connector ───────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
AWS_CUR_BUCKET=
AWS_CUR_PREFIX=

# ── GCP Cloud Connector ───────────────────────────────────────────────────────
# Provide inline JSON for service account key, or enable workload identity.
GCP_SERVICE_ACCOUNT_JSON=
GCP_PROJECT_ID=
GCP_USE_WORKLOAD_IDENTITY=false
GCP_BILLING_EXPORT_TABLE=
GCP_LOGGING_FILTER=

# ── Frontend / CORS ───────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174

# ── Auth Cookies (httpOnly) ───────────────────────────────────────────────────
AUTH_COOKIE_ACCESS_NAME=sp_access_token
AUTH_COOKIE_REFRESH_NAME=sp_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=strict
# Leave empty to follow APP_ENV default (true in production)
AUTH_COOKIE_SECURE=
PASSKEY_RP_ID=localhost
PASSKEY_RP_NAME=CauSium
PASSKEY_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── SMTP Notifications ────────────────────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@causium.local
SMTP_FROM_NAME=CauSium
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
# Comma-separated recipients for operational critical alerts
SMTP_ALERT_TO=

# ── Security / Rate Limiting ──────────────────────────────────────────────────
SECURITY_HEADERS_ENABLED=true
RATE_LIMIT_ENABLED=true
ORIGIN_VALIDATION_ENABLED=true
HSTS_MAX_AGE=31536000

# ── Workers ───────────────────────────────────────────────────────────────────
INGESTION_INTERVAL_HOURS=6
SCORING_INTERVAL_HOURS=1
REPORT_EXPORTS_DIR=.data/report-exports
REPORT_EXPORT_RETENTION_HOURS=24

# ── Monitoring / Grafana ──────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=causium_dev

# ── OpenTelemetry (SP-OP06) ───────────────────────────────────────────────────
# Leave OTEL_EXPORTER_OTLP_ENDPOINT empty to disable tracing (no-op, zero overhead).
# Set to http://jaeger:4317 when running docker-compose, or your OTLP collector URL.
OTEL_SERVICE_NAME=causium-backend
OTEL_EXPORTER_OTLP_ENDPOINT=
# Sampling: 1.0 = 100% (dev), 0.1 = 10% (production high-traffic)
OTEL_SAMPLE_RATIO=1.0
