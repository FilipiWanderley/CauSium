# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-me-in-production-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=stratopulse
POSTGRES_PASSWORD=stratopulse_dev
POSTGRES_DB=stratopulse
DATABASE_URL=postgresql+asyncpg://stratopulse:stratopulse_dev@localhost:5432/stratopulse

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=stratopulse
CLICKHOUSE_PASSWORD=stratopulse_dev
CLICKHOUSE_DB=stratopulse
CLICKHOUSE_SECURE=false
CLICKHOUSE_VERIFY=true

# ── Azure Service Principal ───────────────────────────────────────────────────
# Leave empty to use mock connector
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Encryption (for storing connector credentials) ────────────────────────────
ENCRYPTION_KEY=change-me-32-byte-fernet-key-here=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Auth Cookies (httpOnly) ──────────────────────────────────────────────────
AUTH_COOKIE_ACCESS_NAME=sp_access_token
AUTH_COOKIE_REFRESH_NAME=sp_refresh_token
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
AUTH_COOKIE_SAMESITE=strict
# Keep empty to follow APP_ENV default behavior (true in production)
AUTH_COOKIE_SECURE=

# ── Workers ───────────────────────────────────────────────────────────────────
INGESTION_INTERVAL_HOURS=6
SCORING_INTERVAL_HOURS=1
