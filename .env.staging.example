# CauSium staging environment example
# Use placeholder values only. Never commit real secrets.

APP_ENV=production

DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>?sslmode=require
REDIS_URL=rediss://<user>:<password>@<host>:6380/0
SECRET_KEY=<generate-32-bytes-or-more>
ENCRYPTION_KEY=<generate-fernet-key>

CORS_ORIGINS=https://staging.causium.com

AI_PROVIDER=mock
AI_OPENAI_API_KEY=

CLICKHOUSE_HOST=<clickhouse-host>
CLICKHOUSE_PORT=8443
