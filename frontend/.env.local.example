# CauSium Frontend - Environment Variables Example
# Copy this file to .env.local and customize as needed.
# NEVER commit .env.local to version control.

# ── API Configuration ──────────────────────────────────────────────────────────
# URL of the CauSium API (backend)
VITE_API_URL=https://api.causiumtech.com

# ── Development Options ────────────────────────────────────────────────────────
# Set to 'true' to force using VITE_API_URL even when running on localhost.
# This allows local frontend testing with remote production API.
# Default: false (uses Vite proxy for localhost)
VITE_FORCE_REMOTE_API=false

# ── Usage ───────────────────────────────────────────────────────────────────────
# Normal development (frontend + local backend):
#   Leave VITE_FORCE_REMOTE_API=false or remove it
#   Vite proxy will forward /api requests to localhost:8000
#
# Testing local frontend with remote API:
#   Set VITE_FORCE_REMOTE_API=true
#   API requests will go to VITE_API_URL