{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/landing/*",
      "/*.css",
      "/*.js",
      "/*.map",
      "/*.ico",
      "/*.png",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif",
      "/*.svg",
      "/*.webp",
      "/*.woff",
      "/*.woff2",
      "/*.ttf",
      "/*.eot",
      "/favicon.ico",
      "/robots.txt",
      "/manifest.webmanifest"
    ]
  },
  "routes": [
    {
      "route": "/api/*",
      "rewrite": "https://causium-api-2026-fea3frguggasbcg3.brazilsouth-01.azurewebsites.net/api/*"
    },
    {
      "route": "/login",
      "rewrite": "/index.html"
    },
    {
      "route": "/login/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/app/*",
      "rewrite": "/index.html"
    },
    {
      "route": "/forgot-password",
      "rewrite": "/index.html"
    },
    {
      "route": "/reset-password",
      "rewrite": "/index.html"
    },
    {
      "route": "/activate",
      "rewrite": "/index.html"
    }
  ],
  "globalHeaders": {
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
  }
}
